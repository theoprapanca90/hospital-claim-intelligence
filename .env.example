APP_NAME="Hospital Claim Intelligence"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hci
DB_USERNAME=hci_app
DB_PASSWORD=change_me_locally

MYSQL_DATABASE=hci
MYSQL_USER=hci_app
MYSQL_PASSWORD=change_me_locally
MYSQL_ROOT_PASSWORD=change_me_locally

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

QDRANT_URL=http://127.0.0.1:6333
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_SERVICE_URL=http://127.0.0.1:8001
# Token layanan Laravel -> AI service (min. 32 karakter). Buat lokal: openssl rand -hex 32
# Jangan commit nilai asli. Tanpa token, AI service menolak semua permintaan kerja.
AI_SERVICE_TOKEN=
