# Local development only. Copy to .env and replace every placeholder.
MYSQL_DATABASE=hci
MYSQL_USER=hci_app
MYSQL_PASSWORD=replace_with_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_long_random_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Internal Laravel-to-AI secret; generate with: openssl rand -hex 32
HCI_SERVICE_TOKEN=replace_with_64_hex_characters

# On Apple Silicon Mac, prefer native Ollama (Metal acceleration).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b
AI_REQUEST_TIMEOUT=120
AI_CONTEXT_SIZE=2048

QDRANT_URL=http://127.0.0.1:6333
AI_SERVICE_URL=http://127.0.0.1:8001
APP_ENV=local
